meta {
  name: echo-user
  type: http
  seq: 1
}

post {
  url: http://localhost:8081/api/echo/json
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "username": "{{username}}"
  }
}

tests {
  test('request body carries the data row', () => {
    expect(res.body.username).to.equal(bru.getData('username'));
  });
}
